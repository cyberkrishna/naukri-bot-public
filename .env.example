# Copy to .env and fill in values. .env is gitignored.

# Telegram bot token from BotFather (DO NOT commit the real one)
BOT_TOKEN=

# Mode: "polling" for local dev, "webhook" for production
BOT_MODE=polling

# Webhook config (only used when BOT_MODE=webhook)
WEBHOOK_URL=
WEBHOOK_SECRET=
WEBHOOK_LISTEN=0.0.0.0
WEBHOOK_PORT=8080

# Database. Local dev defaults to sqlite. Render production uses Postgres
# (e.g. postgresql+psycopg://user:pass@host:5432/dbname — set by Render Blueprint).
DB_URL=sqlite:///./bot.db

# Your chat_id for admin commands (get from @userinfobot)
ADMIN_CHAT_ID=

# Path to queries YAML (defaults to app/queries.yaml)
QUERIES_PATH=app/queries.yaml
